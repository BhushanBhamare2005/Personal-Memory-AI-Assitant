# Set a real key for hosted responses; untouched placeholders use local development mode.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# OpenAI alternative (set LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Gemini alternative (set LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY is also accepted as an alternative key name.

# Local persistence
DB_PATH=./data/memory.db
FAISS_INDEX_PATH=./data/vector_store
DOC_VECTOR_STORE_PATH=./data/faiss_documents
EMBEDDING_MODEL=all-MiniLM-L6-v2
